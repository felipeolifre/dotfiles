brew "testssl"                  # Tool which checks for the support of TLS/SSL ciphers and flaws
brew "tldr"                     # Simplified and community-driven man pages
brew "vim"                      # Vi 'workalike' with many additional features
brew "wget"                     # Internet file retriever
brew "ykman"                    # Tool for managing your YubiKey configuration
brew "ykpers"                   # YubiKey personalization library and tool
brew "zsh"                      # UNIX shell (command interpreter)
